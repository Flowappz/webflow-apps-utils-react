{
  "name": "@flowappz/webflow-apps-utils-react",
  "version": "1.1.0",
  "description": "Shared utilities for Webflow apps — React port of @finsweet/webflow-apps-utils (Svelte)",
  "license": "MIT",
  "author": "FlowAppz (https://flowappz.com)",
  "contributors": [
    "Finsweet (https://finsweet.com) — original Svelte library",
    "FlowAppz (https://flowappz.com) — React port"
  ],
  "homepage": "https://github.com/flowappz/webflow-apps-utils-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowappz/webflow-apps-utils-react.git"
  },
  "bugs": {
    "url": "https://github.com/flowappz/webflow-apps-utils-react/issues"
  },
  "keywords": [
    "webflow",
    "webflow-apps",
    "designer-extension",
    "react",
    "components",
    "utilities"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./index.css": "./dist/ui/styles/index.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@webflow/designer-extension-typings": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@webflow/designer-extension-typings": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "cheerio": "^1.2.0",
    "copy-text-to-clipboard": "^3.2.2",
    "csv-parse": "^6.2.1",
    "js-cookie": "^3.0.7",
    "just-debounce": "^1.1.0",
    "lodash-es": "^4.17.21",
    "luxon": "^3.7.2",
    "terser": "^5.46.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@webflow/designer-extension-typings": "^2.2.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
